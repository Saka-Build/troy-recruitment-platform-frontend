server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Emit relative redirects so the published port (e.g. :3000) is preserved
    absolute_redirect off;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Bare /ats has no trailing slash and would otherwise 404.
    location = /ats {
        return 301 /ats/;
    }

    location = / {
        return 301 /ats/;
    }

    # Hashed build output is safe to cache forever.
    location /ats/assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # The shell must never be cached, or clients pin to a stale asset hash.
    location = /ats/index.html {
        add_header Cache-Control "no-store";
    }

    # Client-side routes fall back to the SPA shell.
    location /ats/ {
        try_files $uri $uri/ /ats/index.html;
    }

    # The app calls same-origin /api/v1/...; in dev the Vite proxy handled this.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        client_max_body_size 50m;
    }

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }
}
